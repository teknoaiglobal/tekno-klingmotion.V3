{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/admin/apikeys/cleanup",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/proxy.php",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth.js"
    }
  ]
}
